      22
    ],
    "default_set": [
      "BM",
      "EN",
      "CN"
    ]
  },
  "creative": {
    "call_to_action_type": "MESSAGE_PAGE",
    "max_creatives": 10,
    "file_pattern_pic": "^\\s*(pic|picture|image|img)\\s*[-_ ]?\\s*(\\d{1,2})\\b",
    "file_pattern_video": "^\\s*(video|vid)\\s*[-_ ]?\\s*(\\d{1,2})\\b",
    "cover_pattern": "^(video|vid)\\s*[-_ ]?\\s*(\\d{1,2}).*(cover|封面|thumb)",
    "language_rotation": [
      "BM",
      "EN",
      "CN"
    ],
    "ad_name_pattern": "{kind}{n} | {lang}",
    "degrees_of_freedom_spec": {
      "creative_features_spec": {
        "text_optimizations": {
          "enroll_status": "OPT_OUT"
        }
      }
    },
    "asset_feed_spec": {
      "optimization_type": "DOF_MESSAGING_DESTINATION",
      "call_to_actions": [
        {
          "type": "MESSAGE_PAGE",
          "value": {
            "app_destination": "MESSENGER"
          }
        },
        {
          "type": "WHATSAPP_MESSAGE",
          "value": {
            "app_destination": "WHATSAPP",
            "link": "https://api.whatsapp.com/send"
          }
        }
      ]
    },
    "multi_destination_note": "Verified 2026-11-03 (ad 120253826614110526). Must be sent as an INLINE creative inside ads_create_ad (object_story_spec + asset_feed_spec + degrees_of_freedom_spec). ads_create_creative alone fails with 'Creative is missing DOF spec'. text_optimizations OPT_OUT keeps the copy exactly as written."
  },
  "drive": {
