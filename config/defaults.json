      "countries": [
        "MY"
      ]
    },
    "location_types": [
      "home",
      "recent"
    ],
    "requires_verified_advertiser_MY": "Malaysia targeting needs a verified advertiser/payer. Set once per ad account: Ads Manager (desktop) > Advertising settings > Default advertiser and payer > Malaysia.",
    "created_by": "USER in Ads Manager (Meta MCP cannot set Malaysia's verified advertiser, and cannot set Messenger+WhatsApp). Claude finds it by name 'Broad' in the campaign the user names.",
    "expected_destination_type": "MESSAGING_MESSENGER_WHATSAPP"
  },
  "languages": {
    "comment": "Meta locale IDs copied from the live 'Broad 1 - pic' ad set in G3 Setapak (proven to work).",
    "BM": [
      41
    ],
    "EN": [
      6,
      24
    ],
    "CN": [
